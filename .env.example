# STUDIO FA - Environment Configuration Example
# Duplicate this file to .env.local for local development.
# NEVER commit production secrets or service role keys.

# Supabase Public Configuration (Accessible in Browser)
NEXT_PUBLIC_SUPABASE_URL=https://rfdossffdlayntmyqpnl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Server-Side Secrets (NEVER prefix with NEXT_PUBLIC_)
SUPABASE_URL=https://rfdossffdlayntmyqpnl.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# AI Foundation Configuration (Server-Side Only - NEVER prefix with NEXT_PUBLIC_)
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_VISION_MODEL=gpt-4o
OPENAI_IMAGE_MODEL=dall-e-3
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Application Settings
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
